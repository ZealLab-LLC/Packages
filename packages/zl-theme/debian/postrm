#!/bin/sh
set -e

lockscreen=/usr/share/plasma/shells/org.kde.plasma.desktop/contents/lockscreen/LockScreenUi.qml
mainblock=/usr/share/plasma/shells/org.kde.plasma.desktop/contents/lockscreen/MainBlock.qml
mainblock_backup=/usr/share/zeallab/lockscreen/MainBlock.qml.orig

case "$1" in
    remove|purge)
        if [ -f "$lockscreen" ]; then
            python3 -c '
path = "'"$lockscreen"'"
with open(path, "r") as f:
    content = f.read()

lines = content.splitlines()
new_lines = []
skip = False
for line in lines:
    if "id: zealLabBrandOverlay" in line:
        if new_lines and "Loader {" in new_lines[-1]:
            new_lines.pop()
        skip = True
        continue
    if skip:
        if line.strip() == "}":
            skip = False
        continue
    new_lines.append(line)

content = "\n".join(new_lines) + "\n"
content = content.replace("visible: false", "visible: !config.alwaysShowClock")

with open(path, "w") as f:
    f.write(content)
' || true
        fi

        if [ -f "$mainblock_backup" ] && [ -f "$mainblock" ]; then
            if grep -q "ZealLab lock screen styling" "$mainblock"; then
                cp -p "$mainblock_backup" "$mainblock" || true
            fi
            rm -f "$mainblock_backup"
        fi
        rmdir --ignore-fail-on-non-empty /usr/share/zeallab/lockscreen 2>/dev/null || true
        ;;
esac

#DEBHELPER#
exit 0
