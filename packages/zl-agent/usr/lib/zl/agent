#!/bin/bash
# Description: ZealLab Agent (fork of OpenCode) - a local-only development agent.
# Installation: /usr/lib/zl/agent
#
# Thin shim invoked by the 'zl' dispatcher as `zl agent [args]`. The agent
# itself is a self-contained binary installed by this package; nothing is
# placed on $PATH, so `zl agent` is the only entrypoint.
